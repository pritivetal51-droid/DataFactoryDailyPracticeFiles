{
	"name": "pl_pipeline_variable_",
	"properties": {
		"activities": [
			{
				"name": "copy_sourcefile_to_targetfiles",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "setvartargetfile",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_adls_srcfiles",
						"type": "DatasetReference",
						"parameters": {
							"pSourceFileName": {
								"value": "@pipeline().parameters.pPlSourceFilename",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_adls_targetfiles",
						"type": "DatasetReference",
						"parameters": {
							"pTargetFileName": {
								"value": "@pipeline().parameters.pPlTargetFilename",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "setvartargetfile",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vCurrTimeStamp",
					"value": {
						"value": "@utcNow()",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"pPlSourceFilename": {
				"type": "string"
			},
			"pPlTargetFilename": {
				"type": "string"
			}
		},
		"variables": {
			"vCurrTimeStamp": {
				"type": "String"
			}
		},
		"folder": {
			"name": "my_practice"
		},
		"annotations": []
	}
}